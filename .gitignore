# dependencies
node_modules/

# build output (Vercel/Netlify build this themselves — never commit it)
dist/
dist-ssr/
*.local

# editor / OS
.vscode/*
!.vscode/extensions.json
# Local machine settings only. .claude/skills/ IS committed — those are
# project knowledge and belong with the repo.
.claude/settings.local.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# env (no backend today, but don't let a stray key in later)
.env
.env.*
!.env.example

# host tooling
.vercel/
.netlify/

# scratch / staging junk
_to_delete/
*.tgz

# Android/TWA toolchain — JDK 17 + Android SDK live here, downloaded locally.
# Hundreds of MB of binaries; never commit. (android/ itself IS committed.)
android-tools/

# Signing keys NEVER go in git. Losing this file means you can never ship an
# update to the Play listing again — back it up outside the repo.
*.keystore
*.jks

# Android build outputs (the android/ sources and twa-manifest.json ARE committed)
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/release/
android/*.apk
android/*.aab
